{
  "name": "siren-call",
  "version": "1.0.0",
  "description": "Lua and Sing Discord audience selection",
  "scripts": {
    "build": "tsc && cp src/languages/lua/runtime.lua dist/languages/lua/runtime.lua && cp compiler/compiler.sing dist/compiler/compiler.sing",
    "start": "node --env-file-if-exists=.env dist/discord/bot.js",
    "dev": "pnpm run build && pnpm start",
    "register": "pnpm run build && node --env-file-if-exists=.env dist/discord/register.js",
    "typecheck": "pnpm run build && tsc -p tsconfig.test.json",
    "lint": "oxlint && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test",
    "sing": "pnpm run build && node dist/sing-cli.js",
    "preview": "pnpm run build && node dist/preview.js",
    "sing:compile": "pnpm run build && node dist/compiler/cli.js",
    "sing:bootstrap": "pnpm run build && node dist/compiler/bootstrap-cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aminmiri82/siren-call.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Aminmiri82/siren-call/issues"
  },
  "homepage": "https://github.com/Aminmiri82/siren-call#readme",
  "dependencies": {
    "discord.js": "^14.27.0",
    "wasmoon": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "private": true,
  "engines": {
    "node": ">=24.17.0"
  },
  "packageManager": "pnpm@10.33.0"
}
